+// Temporary speed boost. Only changes the in-memory frame limit, nothing is written to the
+// config, and the previous value is restored when the boost is turned off.
+static bool turbo_speed_active = false;
+static double turbo_speed_saved_limit = 100.0;
+
+jboolean JNICALL Java_io_github_mandarine3ds_mandarine_NativeLibrary_setTurboSpeed(
+    [[maybe_unused]] JNIEnv* env, [[maybe_unused]] jobject obj, jboolean enable, jint percent) {
+    auto& frame_limit = Settings::values.frame_limit;
+    if (enable) {
+        if (turbo_speed_active) {
+            return JNI_TRUE;
+        }
+        const double current = frame_limit.GetValue();
+        // 0 means "no limit" and a higher value is already faster, so do nothing in both cases.
+        if (current <= 0.0 || current >= static_cast<double>(percent)) {
+            return JNI_FALSE;
+        }
+        turbo_speed_saved_limit = current;
+        frame_limit.SetValue(static_cast<double>(percent));
+        turbo_speed_active = true;
+        return JNI_TRUE;
+    }
+    if (turbo_speed_active) {
+        frame_limit.SetValue(turbo_speed_saved_limit);
+        turbo_speed_active = false;
+    }
+    return JNI_FALSE;
+}
+
+jboolean JNICALL Java_io_github_mandarine3ds_mandarine_NativeLibrary_isTurboSpeedActive(
+    [[maybe_unused]] JNIEnv* env, [[maybe_unused]] jobject obj) {
+    return turbo_speed_active ? JNI_TRUE : JNI_FALSE;
+}
